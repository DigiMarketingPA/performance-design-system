<script>
    // FAQ Accordion Functionality
    document.addEventListener('DOMContentLoaded', function() {
        // Remove empty <p> tags
        const allParagraphs = document.querySelectorAll('p');
        allParagraphs.forEach(function(p) {
            // Check if paragraph is empty (no text content, only whitespace, or only HTML entities/whitespace)
            const textContent = p.textContent.trim();
            const innerHTML = p.innerHTML.trim();
            
            // Remove if empty or only contains whitespace/nbsp
            if (!textContent || innerHTML === '' || innerHTML === '&nbsp;' || innerHTML === '\u00A0') {
                p.remove();
            }
        });

        const faqItems = document.querySelectorAll('.faq1, .faq2, .faq3, .faq4');
        
        faqItems.forEach(function(faqItem) {
            const faqHeader = faqItem.querySelector('h4');
            
            faqHeader.addEventListener('click', function() {
                // Toggle active class on clicked item
                faqItem.classList.toggle('active');
                
                faqItems.forEach(function(otherItem) {
                    if (otherItem !== faqItem) {
                        otherItem.classList.remove('active');
                    }
                });
            });
        });

        // Store Modal Functionality
        const storeCards = document.querySelectorAll('.store-card');
        const storeModals = document.querySelectorAll('.store-modal');
        const closeButtons = document.querySelectorAll('.modal-close');

        // Open modal when store card is clicked
        storeCards.forEach(function(card) {
            card.addEventListener('click', function(e) {
                e.preventDefault(); // Prevent any default actions
                const storeNumber = card.getAttribute('data-store');
                const modal = document.getElementById('storeModal' + storeNumber);
                if (modal) {
                    modal.classList.add('active');
                    document.body.style.overflow = 'hidden'; // Prevent background scrolling
                } else {
                    console.warn('Modal not found: storeModal' + storeNumber);
                }
            });
        });

        // Close modal when close button is clicked
        closeButtons.forEach(function(button) {
            button.addEventListener('click', function(e) {
                e.stopPropagation(); // Prevent event from bubbling
                const modal = button.closest('.store-modal');
                if (modal) {
                    modal.classList.remove('active');
                    document.body.style.overflow = ''; // Restore scrolling
                }
            });
        });

        // Close modal when clicking outside the modal content
        storeModals.forEach(function(modal) {
            modal.addEventListener('click', function(e) {
                if (e.target === modal) {
                    modal.classList.remove('active');
                    document.body.style.overflow = ''; // Restore scrolling
                }
            });
        });

        // Close modal with Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                storeModals.forEach(function(modal) {
                    if (modal.classList.contains('active')) {
                        modal.classList.remove('active');
                        document.body.style.overflow = ''; // Restore scrolling
                    }
                });
            }
        });
    });
</script>

