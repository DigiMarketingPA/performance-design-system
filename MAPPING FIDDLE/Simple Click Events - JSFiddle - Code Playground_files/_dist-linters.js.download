		                                suffix = "";

		                            if (
		                                tokenBefore &&
		                                tokenBefore.range[1] === node.range[0] &&
		                                !astUtils.canTokensBeAdjacent(tokenBefore, replacement)
		                            ) {
		                                prefix = " ";
		                            }

		                            if (
		                                tokenAfter &&
		                                node.range[1] === tokenAfter.range[0] &&
		                                !astUtils.canTokensBeAdjacent(replacement, tokenAfter)
		                            ) {
