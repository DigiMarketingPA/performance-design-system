	var hasRequiredNoThisBeforeSuper;

	function requireNoThisBeforeSuper () {
		if (hasRequiredNoThisBeforeSuper) return noThisBeforeSuper;
		hasRequiredNoThisBeforeSuper = 1;

		//------------------------------------------------------------------------------
		// Requirements
		//------------------------------------------------------------------------------

