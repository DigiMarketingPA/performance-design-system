		hasRequiredNoProcessExit = 1;

		//------------------------------------------------------------------------------
		// Rule Definition
		//------------------------------------------------------------------------------

		/** @type {import('../shared/types').Rule} */
		noProcessExit = {
		    meta: {
		        deprecated: true,

		        replacedBy: [],

		        type: "suggestion",

		        docs: {
		            description: "Disallow the use of `process.exit()`",
		            recommended: false,
		            url: "https://eslint.org/docs/latest/rules/no-process-exit"
		        },

		        schema: [],

		        messages: {
