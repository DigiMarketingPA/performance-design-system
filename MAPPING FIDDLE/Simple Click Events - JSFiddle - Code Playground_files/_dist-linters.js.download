		                const rightToken = sourceCode.getTokenAfter(operatorToken);

		                if (
		                    !sourceCode.isSpaceBetweenTokens(leftToken, operatorToken) ||
		                    !sourceCode.isSpaceBetweenTokens(operatorToken, rightToken)
