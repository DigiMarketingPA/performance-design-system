		//------------------------------------------------------------------------------
		// Rule Definition
		//------------------------------------------------------------------------------

		/** @type {import('../shared/types').Rule} */
		noUnusedLabels = {
		    meta: {
		        type: "suggestion",

		        docs: {
		            description: "Disallow unused labels",
		            recommended: true,
		            url: "https://eslint.org/docs/latest/rules/no-unused-labels"
