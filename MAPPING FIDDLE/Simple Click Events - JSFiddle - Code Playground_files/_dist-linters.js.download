		                        loc: {
		                            start: tokenBeforeFirst.loc.start,
		                            end: firstBlockToken.loc.start
		                        },
		                        fix(fixer) {
		                            return fixer.replaceTextRange([tokenBeforeFirst.range[1], firstBlockToken.range[0] - firstBlockToken.loc.start.column], "\n");
		                        },
		                        messageId: "neverPadBlock"
