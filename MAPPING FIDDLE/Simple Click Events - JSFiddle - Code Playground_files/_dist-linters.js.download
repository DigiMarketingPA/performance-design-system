		            anyOf: [
		                {
		                    type: "array",
		                    items: [
		                        {
		                            enum: ["always"]
		                        },
		                        {
		                            type: "object",
		                            properties: {
		                                null: {
		                                    enum: ["always", "never", "ignore"]
		                                }
		                            },
		                            additionalProperties: false
		                        }
		                    ],
		                    additionalItems: false
		                },
		                {
		                    type: "array",
		                    items: [
		                        {
		                            enum: ["smart", "allow-null"]
		                        }
		                    ],
		                    additionalItems: false
