		            checkUnaryWordOperatorForSpaces(node, tokens[0], tokens[1], word);
		        }

		        /**
		         * Verifies AwaitExpressions satisfy spacing requirements
		         * @param {ASTNode} node AwaitExpression AST node
		         * @returns {void}
		         */
		        function checkForSpacesAfterAwait(node) {
