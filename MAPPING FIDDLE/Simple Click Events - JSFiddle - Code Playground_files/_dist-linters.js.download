		                case "IfStatement":
		                    if (!node.alternate) {
		                        return true;
		                    }
		                    return hasUnsafeIf(node.alternate);
		                case "ForStatement":
		                case "ForInStatement":
		                case "ForOfStatement":
		                case "LabeledStatement":
		                case "WithStatement":
