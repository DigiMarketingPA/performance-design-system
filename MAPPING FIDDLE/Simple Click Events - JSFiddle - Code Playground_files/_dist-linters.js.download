		hasRequiredBraceStyle = 1;

		const astUtils = requireAstUtils();

		//------------------------------------------------------------------------------
		// Rule Definition
		//------------------------------------------------------------------------------

		/** @type {import('../shared/types').Rule} */
		braceStyle = {
		    meta: {
		        deprecated: true,
		        replacedBy: [],
		        type: "layout",

		        docs: {
		            description: "Enforce consistent brace style for blocks",
		            recommended: false,
		            url: "https://eslint.org/docs/latest/rules/brace-style"
