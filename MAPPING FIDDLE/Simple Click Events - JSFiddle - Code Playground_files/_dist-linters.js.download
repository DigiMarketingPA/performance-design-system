		//------------------------------------------------------------------------------
		// Public Interface
		//------------------------------------------------------------------------------

		const ConfigArraySymbol = {
			isNormalized: Symbol('isNormalized'),
			configCache: Symbol('configCache'),
			schema: Symbol('schema'),
			finalizeConfig: Symbol('finalizeConfig'),
			preprocessConfig: Symbol('preprocessConfig')
