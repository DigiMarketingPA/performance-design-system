		    meta: {
		        type: "suggestion",

		        docs: {
		            description: "Disallow unnecessary calls to `.bind()`",
		            recommended: false,
		            url: "https://eslint.org/docs/latest/rules/no-extra-bind"
		        },

		        schema: [],
		        fixable: "code",

		        messages: {
		            unexpected: "The function binding is unnecessary."
		        }
		    },

		    create(context) {
		        const sourceCode = context.sourceCode;
		        let scopeInfo = null;

