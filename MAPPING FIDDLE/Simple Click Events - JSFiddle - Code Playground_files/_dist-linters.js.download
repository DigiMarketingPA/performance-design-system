		}

		//------------------------------------------------------------------------------
		// Rule Definition
		//------------------------------------------------------------------------------

		/** @type {import('../shared/types').Rule} */
		noUselessComputedKey = {
		    meta: {
		        type: "suggestion",

		        docs: {
		            description: "Disallow unnecessary computed property keys in objects and classes",
		            recommended: false,
