		                    ],
		                    minItems: 0,
		                    maxItems: 1
		                },
		                {
		                    type: "array",
		                    items: [
		                        {
		                            enum: ["never"]
		                        },
		                        {
		                            type: "object",
		                            properties: {
		                                ignoreForLoopInit: {
		                                    type: "boolean"
		                                }
		                            },
		                            additionalProperties: false
		                        }
