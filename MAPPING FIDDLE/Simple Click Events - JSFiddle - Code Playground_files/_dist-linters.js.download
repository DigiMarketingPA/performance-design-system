		const SENTINEL_TYPE = /^(?:(?:Function|Class)(?:Declaration|Expression)|ArrowFunctionExpression|CatchClause|ImportDeclaration|ExportNamedDeclaration)$/u;
		const FOR_IN_OF_TYPE = /^For(?:In|Of)Statement$/u;

		/**
