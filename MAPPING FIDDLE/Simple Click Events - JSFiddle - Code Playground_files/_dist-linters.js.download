		function getLeft(node) {
		    let left = node.left;

		    while (isConcatenation(left)) {
		        left = left.right;
		    }
		    return left;
		}

		/**
		 * Get's the left most node on the right side of a BinaryExpression with + operator.
		 * @param {ASTNode} node A BinaryExpression node to check.
		 * @returns {ASTNode} node
