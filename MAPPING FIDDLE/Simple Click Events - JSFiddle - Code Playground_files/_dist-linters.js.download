		// Rule Definition
		//------------------------------------------------------------------------------

		/** @type {import('../shared/types').Rule} */
		noWith = {
		    meta: {
		        type: "suggestion",

		        docs: {
		            description: "Disallow `with` statements",
		            recommended: true,
		            url: "https://eslint.org/docs/latest/rules/no-with"
		        },

		        schema: [],

		        messages: {
		            unexpectedWith: "Unexpected use of 'with' statement."
		        }
