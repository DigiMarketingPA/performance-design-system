		            if (lastLeadingComment.loc.end.line === tokenBefore.loc.end.line &&
		                lastLeadingComment.loc.end.line !== node.loc.start.line) {
		                return true;
		            }

		            return false;
		        }

		        //--------------------------------------------------------------------------
		        // Public
		        //--------------------------------------------------------------------------

		        return {
		            ReturnStatement(node) {
		                if (!isFirstNode(node) && !hasNewlineBefore(node)) {
		                    context.report({
		                        node,
		                        messageId: "expected",
		                        fix(fixer) {
