		preferSpread = {
		    meta: {
		        type: "suggestion",

		        docs: {
		            description: "Require spread operators instead of `.apply()`",
		            recommended: false,
		            url: "https://eslint.org/docs/latest/rules/prefer-spread"
		        },

		        schema: [],
		        fixable: null,

		        messages: {
		            preferSpread: "Use the spread operator instead of '.apply()'."
		        }
		    },

