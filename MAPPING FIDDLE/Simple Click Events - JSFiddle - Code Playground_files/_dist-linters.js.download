		        }
		    });
		    return map;
		}

		//------------------------------------------------------------------------------
		// Rule Definition
		//------------------------------------------------------------------------------

		/** @type {import('../shared/types').Rule} */
		maxLinesPerFunction = {
		    meta: {
		        type: "suggestion",

		        docs: {
		            description: "Enforce a maximum number of lines of code in a function",
		            recommended: false,
		            url: "https://eslint.org/docs/latest/rules/max-lines-per-function"
		        },

		        schema: [
		            OPTIONS_OR_INTEGER_SCHEMA
