	}

	/**
	 * @fileoverview Rule to flag `else` after a `return` in `if`
	 * @author Ian Christian Myers
	 */

	var noElseReturn;
	var hasRequiredNoElseReturn;

	function requireNoElseReturn () {
		if (hasRequiredNoElseReturn) return noElseReturn;
