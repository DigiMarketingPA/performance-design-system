		            if (!(FUNC_EXPR_NODE_TYPES.has(variableScope.block.type) && getOuterScope(variableScope) === shadowedVariable.scope)) {
		                return false;
		            }

		            const fun = variableScope.block;
		            const { parent } = fun;

