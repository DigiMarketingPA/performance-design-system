		preferObjectHasOwn = {
		    meta: {
		        type: "suggestion",
		        docs: {
		            description:
		                "Disallow use of `Object.prototype.hasOwnProperty.call()` and prefer use of `Object.hasOwn()`",
		            recommended: false,
		            url: "https://eslint.org/docs/latest/rules/prefer-object-has-own"
		        },
		        schema: [],
