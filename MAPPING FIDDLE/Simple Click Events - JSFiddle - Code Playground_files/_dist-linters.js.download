		                            node,
		                            messageId: "required",
		                            data: {
		                                group: group.raw
		                            },
		                            suggest
		                        });
		                    }
		                }
		            });
		        }

		        return {
		            Literal(node) {
		                if (node.regex) {
		                    checkRegex(node.regex.pattern, node, node, node.regex.flags);
		                }
		            },
		            Program(node) {
		                const scope = sourceCode.getScope(node);
		                const tracker = new ReferenceTracker(scope);
