		const validator = new RegExpValidator();
		const validFlags = /[dgimsuvy]/gu;
		const undefined1 = void 0;

		//------------------------------------------------------------------------------
		// Rule Definition
		//------------------------------------------------------------------------------

		/** @type {import('../shared/types').Rule} */
