		                    continue;
		                }

		                if (hasSeenPlainParam && param.type === "AssignmentPattern") {
		                    context.report({
		                        node: param,
		                        messageId: "shouldBeLast"
		                    });
		                }
		            }
		        }

		        return {
		            FunctionDeclaration: handleFunction,
		            FunctionExpression: handleFunction,
		            ArrowFunctionExpression: handleFunction
		        };
		    }
		};
