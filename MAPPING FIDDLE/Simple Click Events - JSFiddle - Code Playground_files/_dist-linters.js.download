		        }
		    }
		}

		//------------------------------------------------------------------------------
		// Rule Definition
		//------------------------------------------------------------------------------

		/** @type {import('../shared/types').Rule} */
		noDupeKeys = {
		    meta: {
		        type: "problem",

		        docs: {
		            description: "Disallow duplicate keys in object literals",
		            recommended: true,
		            url: "https://eslint.org/docs/latest/rules/no-dupe-keys"
		        },

