		            const callNode = memberNode.parent.type === "ChainExpression"
		                ? memberNode.parent.parent
		                : memberNode.parent;

		            context.report({
		                node: callNode,
		                messageId: "unexpected",
		                loc: memberNode.property.loc,

		                fix(fixer) {
		                    if (!isSideEffectFree(callNode.arguments[0])) {
		                        return null;
		                    }

