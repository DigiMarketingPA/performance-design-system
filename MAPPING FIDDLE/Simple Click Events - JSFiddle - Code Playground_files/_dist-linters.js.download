		//------------------------------------------------------------------------------
		// Rule Definition
		//------------------------------------------------------------------------------

		/** @type {import('../shared/types').Rule} */
		noPathConcat = {
		    meta: {
		        deprecated: true,

		        replacedBy: [],

		        type: "suggestion",

		        docs: {
		            description: "Disallow string concatenation with `__dirname` and `__filename`",
		            recommended: false,
		            url: "https://eslint.org/docs/latest/rules/no-path-concat"
