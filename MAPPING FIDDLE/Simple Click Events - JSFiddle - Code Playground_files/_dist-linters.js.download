		                        node,
		                        loc: {
		                            start: tokenBefore.loc.end,
		                            end: currentArgToken.loc.start
		                        },
		                        messageId: checker.messageId,
		                        fix: hasLineCommentBefore ? null : checker.createFix(currentArgToken, tokenBefore)
