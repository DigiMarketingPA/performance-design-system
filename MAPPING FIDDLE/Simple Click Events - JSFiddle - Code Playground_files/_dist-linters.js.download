		        }

		        /**
		         * Checks if a variable is in TDZ of scopeVar.
		         * @param {Object} variable The variable to check.
		         * @param {Object} scopeVar The variable of TDZ.
		         * @returns {boolean} Whether or not the variable is in TDZ of scopeVar.
