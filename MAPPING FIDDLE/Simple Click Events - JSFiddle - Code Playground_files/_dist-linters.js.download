		//------------------------------------------------------------------------------
		// Rule Definition
		//------------------------------------------------------------------------------

		/** @type {import('../shared/types').Rule} */
		switchColonSpacing = {
		    meta: {
		        deprecated: true,
		        replacedBy: [],
		        type: "layout",

		        docs: {
		            description: "Enforce spacing around colons of switch statements",
		            recommended: false,
		            url: "https://eslint.org/docs/latest/rules/switch-colon-spacing"
