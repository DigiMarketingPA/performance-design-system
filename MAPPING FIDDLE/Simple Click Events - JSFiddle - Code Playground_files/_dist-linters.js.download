		    meta: {
		        type: "suggestion",

		        docs: {
		            description: "Disallow `Array` constructors",
		            recommended: false,
		            url: "https://eslint.org/docs/latest/rules/no-array-constructor"
		        },

		        hasSuggestions: true,

		        schema: [],

