		hasRequiredNonblockStatementBodyPosition = 1;

		//------------------------------------------------------------------------------
		// Rule Definition
		//------------------------------------------------------------------------------

		const POSITION_SCHEMA = { enum: ["beside", "below", "any"] };

		/** @type {import('../shared/types').Rule} */
		nonblockStatementBodyPosition = {
		    meta: {
		        deprecated: true,
