		                context.report({ node: node.parent, messageId: "noProcessExit" });
		            }
		        };

		    }
		};
		return noProcessExit;
	}

	/**
	 * @fileoverview Rule to disallow returning values from Promise executor functions
	 * @author Milos Djermanovic
	 */

