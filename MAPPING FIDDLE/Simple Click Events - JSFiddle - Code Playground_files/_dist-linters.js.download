		    switch (regexNode.type) {
		        case "Literal":
		            if (typeof regexNode.value === "string" && rawText.includes("\\")) {
		                return null;
		            }
		            break;
		        case "TemplateLiteral":
		            if (regexNode.expressions.length || rawText.slice(1, -1) !== pattern) {
		                return null;
		            }
		            break;
