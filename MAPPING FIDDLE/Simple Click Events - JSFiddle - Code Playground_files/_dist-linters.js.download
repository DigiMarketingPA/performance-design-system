		                }

		                if (lines.length > max) {
		                    const loc = {
		                        start: {
		                            line: lines[max].lineNumber,
		                            column: 0
		                        },
		                        end: {
		                            line: sourceCode.lines.length,
		                            column: sourceCode.lines.at(-1).length
		                        }
		                    };

		                    context.report({
		                        loc,
		                        messageId: "exceed",
		                        data: {
		                            max,
		                            actual: lines.length
		                        }
		                    });
		                }
		            }
		        };
		    }
		};
