		    meta: {
		        deprecated: true,
		        replacedBy: [],
		        type: "layout",

		        docs: {
		            description: "Enforce consistent line breaks inside function parentheses",
		            recommended: false,
		            url: "https://eslint.org/docs/latest/rules/function-paren-newline"
		        },

		        fixable: "whitespace",

		        schema: [
		            {
		                oneOf: [
