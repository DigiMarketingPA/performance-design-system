		    meta: {
		        deprecated: true,
		        replacedBy: [],
		        type: "layout",

		        docs: {
		            description: "Require or disallow padding lines between statements",
		            recommended: false,
		            url: "https://eslint.org/docs/latest/rules/padding-line-between-statements"
