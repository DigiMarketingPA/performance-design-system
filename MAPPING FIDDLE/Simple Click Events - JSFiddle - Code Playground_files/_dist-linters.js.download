		                    const location = getDeclaredLocation(shadowed);
		                    const messageId = location.global ? "noShadowGlobal" : "noShadow";
		                    const data = { name: variable.name };

		                    if (!location.global) {
		                        data.shadowedLine = location.line;
		                        data.shadowedColumn = location.column;
