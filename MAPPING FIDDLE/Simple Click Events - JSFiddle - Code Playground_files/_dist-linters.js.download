		                        node,
		                        loc,
		                        messageId: "max",
		                        data: {
		                            lineLength,
		                            maxLength
		                        }
		                    });
		                }
		            });
		        }


		        //--------------------------------------------------------------------------
		        // Public API
		        //--------------------------------------------------------------------------

		        return {
		            Program: checkProgramForMaxLength
		        };

		    }
		};
		return maxLen;
	}

	/**
	 * @fileoverview enforce a maximum file length
	 * @author Alberto Rodríguez
	 */

	var maxLines;
	var hasRequiredMaxLines;

	function requireMaxLines () {
		if (hasRequiredMaxLines) return maxLines;
		hasRequiredMaxLines = 1;

		//------------------------------------------------------------------------------
		// Requirements
		//------------------------------------------------------------------------------

		const astUtils = requireAstUtils();

		//------------------------------------------------------------------------------
		// Helpers
		//------------------------------------------------------------------------------

		/**
		 * Creates an array of numbers from `start` up to, but not including, `end`
		 * @param {number} start The start of the range
		 * @param {number} end The end of the range
		 * @returns {number[]} The range of numbers
