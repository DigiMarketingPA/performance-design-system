		        fixable: "whitespace",

		        schema: [
		            {
		                type: "object",
		                properties: {
		                    before: { type: "boolean", default: true },
		                    after: { type: "boolean", default: true },
		                    overrides: {
		                        type: "object",
		                        properties: KEYS.reduce((retv, key) => {
