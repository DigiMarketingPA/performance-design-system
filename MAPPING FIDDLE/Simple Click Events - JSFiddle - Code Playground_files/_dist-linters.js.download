		            MODE_NEVER = "never";

		        const mode = context.options[0] || MODE_ALWAYS;
		        const params = context.options[1] || {};

		        //--------------------------------------------------------------------------
		        // Public API
		        //--------------------------------------------------------------------------

		        return {
		            "VariableDeclaration:exit"(node) {

