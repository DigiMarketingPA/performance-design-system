(function(mod) {
  if (typeof exports == "object" && typeof module == "object") // CommonJS
    mod(require("../../lib/codemirror"));
  else if (typeof define == "function" && define.amd) // AMD
    define(["../../lib/codemirror"], mod);
  else // Plain browser env
    mod(CodeMirror);
})(function(CodeMirror) {
"use strict";

  // var defaultConfig = {
  //   // "ecmaFeatures": {},
  //   languageOptions: {
  //     sourceType: "script",
  //     parserOptions: {
  //       globalReturn: true,
  //       jsx: true
  //     }
  //   },
  //   "rules": {
  //       "no-compare-neg-zero": 1,
  //       "no-cond-assign": 1,
  //       "no-dupe-args": 1,
  //       "no-dupe-keys": 1,
  //       "no-duplicate-case": 1,
  //       "no-extra-semi": 1,
  //       "no-invalid-regexp": 2,
  //       "no-template-curly-in-string": 1,
  //       "no-unsafe-finally": 1,
  //       "no-unsafe-negation": 1,
  //       "no-eval": 1,
  //       "no-implied-eval": 1
  //   }
  // }


  let validator = function(text, options){
    let linter = new eslint.Linter()
    let result = []
    // let config = defaultConfig
    let errors = linter.verify(text, options)

    for (var i = 0; i < errors.length; i++){
      let error = errors[i]

      result.push({
        message:  error.message,
        severity: getSeverity(error),
        from:     getStartPosition(error),
        to:       getEndPosition(error)
      })
    }
    return result
  }

  CodeMirror.registerHelper("lint", "javascript", validator)

  let getStartPosition = function(error){
    let line   = error.line - 1
    let column = error.column - 1

    return CodeMirror.Pos(line, column)
  }

  let getEndPosition = function(error){
    let line   = error.endLine
    let column = error.endColumn

    if (line && column){
      return CodeMirror.Pos(line - 1, column - 1)
    } else {
      return CodeMirror.Pos(0, 0)
    }
  }

  let getSeverity = function(error){
    switch(error.severity){
      case 1:
        return "warning"
      case 2:
        return "error"
      default:
        return "error"
    }
  }

});

// declare global: stylelint

(function(mod) {
  if (typeof exports == "object" && typeof module == "object") // CommonJS
    mod(require("../../lib/codemirror"));
  else if (typeof define == "function" && define.amd) // AMD
    define(["../../lib/codemirror"], mod);
  else // Plain browser env
    mod(CodeMirror);
})(function(CodeMirror) {
"use strict";

// console.log("hello")

  let pushMessage = (results, message) => {
    let startLine = message.line - 1
    let endLine   = message.endLine - 1
    let startCol  = message.column - 1
    let endCol    = message.endColumn - 1

    results.push({
      from:     CodeMirror.Pos(startLine, startCol),
      to:       CodeMirror.Pos(endLine, endCol),
      message:  message.text.split("(")[0],
      severity: message.severity
    })
  }

  let validate = (text, options) => {
    let results = []

    if (!window.stylelint){
      if (window.console){
          window.console.error("Error: window.stylelint not defined, CodeMirror CSS linting cannot run.")
      }
      return results
    }

    return stylelint.lint({
      code:   text,
      config: options
    }).then(output => {
      let messages = output.results[0].warnings

      for (const message of messages){
        pushMessage(results, message)
      }

      return results

    }).catch(err => {
      pushMessage(results, err)

      return results
    })
  }

  CodeMirror.registerHelper("lint", "css", validate)
});

// CodeMirror, copyright (c) by Marijn Haverbeke and others
// Distributed under an MIT license: https://codemirror.net/5/LICENSE

// Depends on htmlhint.js from http://htmlhint.com/js/htmlhint.js

// declare global: HTMLHint

(function(mod) {
  if (typeof exports == "object" && typeof module == "object") // CommonJS
    mod(require("../../lib/codemirror"), require("htmlhint"));
  else if (typeof define == "function" && define.amd) // AMD
    define(["../../lib/codemirror", "htmlhint"], mod);
  else // Plain browser env
    mod(CodeMirror, window.HTMLHint);
})(function(CodeMirror, HTMLHint) {
  "use strict";

  var defaultRules = {
    "tagname-lowercase": true,
    "attr-lowercase": true,
    "attr-value-double-quotes": true,
    "doctype-first": false,
    "tag-pair": true,
    "spec-char-escape": true,
    "id-unique": true,
    "src-not-empty": true,
    "attr-no-duplication": true
  };

  CodeMirror.registerHelper("lint", "html", function(text, options) {
    var found = [];
    if (HTMLHint && !HTMLHint.verify) {
      if(typeof HTMLHint.default !== 'undefined') {
        HTMLHint = HTMLHint.default;
      } else {
        HTMLHint = HTMLHint.HTMLHint;
      }
    }
    if (!HTMLHint) HTMLHint = window.HTMLHint;
    if (!HTMLHint) {
      if (window.console) {
          window.console.error("Error: HTMLHint not found, not defined on window, or not available through define/require, CodeMirror HTML linting cannot run.");
      }
      return found;
    }
    var messages = HTMLHint.verify(text, options && options.rules || defaultRules);
    for (var i = 0; i < messages.length; i++) {
      var message = messages[i];
      var startLine = message.line - 1, endLine = message.line - 1, startCol = message.col - 1, endCol = message.col;
      found.push({
        from: CodeMirror.Pos(startLine, startCol),
        to: CodeMirror.Pos(endLine, endCol),
        message: message.message,
        severity : message.type
      });
    }
    return found;
  });
});
