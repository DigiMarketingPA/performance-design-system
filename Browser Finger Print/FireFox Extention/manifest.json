{
  "manifest_version": 2,
  "name": "Privacy Shield",
  "version": "1.0",
  "description": "Automatically blocks cookies and prevents browser fingerprinting - Enhanced with uBlock Origin integration",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "cookies",
    "storage",
    "privacy",
    "management",
    "tabs",
    "webNavigation",
    "contextMenus",
    "notifications",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/shield-48.png",
      "96": "icons/shield-96.png"
    }
  },
  "icons": {
    "48": "icons/shield-48.png",
    "96": "icons/shield-96.png"
  },
  "web_accessible_resources": [
    "icons/*"
  ]
} 